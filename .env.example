# Conexão ao executar a API fora do Docker.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/c216

# Origens permitidas no CORS (vírgula, sem *).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# URL da API usada pelo frontend (Vite).
VITE_API_URL=http://127.0.0.1:8000

# Os testes usam SQLite temporário por padrão.
# Para testar em PostgreSQL, informe um banco exclusivo de testes.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/c216_test
